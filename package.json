{
  "name": "lamarr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{ts,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{ts,json,html}\"",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vuetify": "^3.8.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.2.0",
    "vitest": "^5.1.2",
    "vue-tsc": "^2.2.4"
  }
}
